@startuml component-overview
title DocSentinel - component overview (as built, src/docsentinel)
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle

package "Consumers" {
  [cli.py\nscan | baseline | extract-facts | init | rules | doctor\n~-~-include / ~-~-exclude on scan and baseline\n~-~-use-external-api on scan and baseline] as cli
  [~__init~__.py\nPython API: scan, load_config,\nload_config_with_sources, ConfigSources, ...] as api
  [pytest_plugin.py\ndocsentinel_scan fixture] as plugin
  [.pre-commit-hooks.yaml\ndocsentinel-fast / -standard] as precommit
}

package "Core" {
  [engine.py\nscan(..., use_external_api=), extract_facts()\nshared _inventory step] as engine
  [config.py\nConfig, load_config, ConfigError,\nload_config_with_sources, ConfigSources] as config
  [discovery.py\ndiscover(), discover_with_stats(),\nnormalize_invoker_selectors(),\nselector_root_spellings()] as discovery
  [rules.py\nRULES, ANALYZERS, opt_in_satisfied] as rules
  [models.py\nDocument, Finding, ScanResult] as models
  [baseline.py\nfingerprints, filter_baselined] as baseline
  [code_discovery.py\ndiscover_python()] as codedisc
  [errors.py\nExtraNotInstalledError] as errors
  [log.py\nsafe(), configure_cli_logging,\nstderr handler + per-run log file] as log
}

package "Detectors (see component-detectors)" {
  [Fast DS1xx\nstdlib only, eager] as fast
  [unreadable.py DS100\nRule registration only, no analyzer] as unreadable
  [Standard DS2xx\nlazy via detectors/loader.py] as standard
  [Deep DS301, DS302\nlazy spaCy/textacy;\nDS302 consent-gated] as deep
  [markdown_blocks.py\nshared scanner + resolver] as mdblocks
}

package "Mining (src/docsentinel/mining; depends only on models and log)" {
  [corpus.py\nTF-IDF corpus model, create_vectorizer()] as miningcorpus
  [claims.py\nClaim, extract_claims (lazy)] as claims
  [nlp.py\nspaCy readiness, load_pipeline, deep_ready()] as deepsup
  [salience.py\ntrace_salience, select_salient] as salience
  [clustering.py\ncluster_near_duplicates] as clustering
}

package "Fact-check backends (src/docsentinel/fact_check; Protocol boundary, imports no detector, config or engine)" {
  [protocol.py\nFactCheckClient Protocol, FactCheckResult,\nFactCheckError, static load_backend] as fcproto
  [lenz.py\nLenzFactCheckClient\nonly module that imports httpx] as lenz
}

package "Reporting (see component-reporting)" {
  [reporting.py\nrender() shim] as reporting
  [telemetry/\nReportModel, FactsModel, template loader+engine,\nextensions, classify] as telemetry
}

cloud "External Lenz service\n(POST /assess)" as lenzsvc

package "Inputs and outputs (file system)" {
  database "Markdown corpus" as corpus
  database "docsentinel.toml / doc_sentinel.toml\npyproject.toml [tool.doc_sentinel]\nexplicit ~-~-config FILE (.toml or .json)" as cfgfiles
  database "User settings JSON\n(layer 2; DOCSENTINEL_SETTINGS, else\nXDG_DATA_HOME or ~~/.local/share)" as usersettings
  database "Environment\nDOCSENTINEL_SETTINGS, XDG_DATA_HOME, HOME" as env
  database "Baseline JSON" as basefile
  database "Per-run log file\n(DOCSENTINEL_LOG_DIR or user log dir)" as logfile
  database "User templates dir\n(report_templates_dir)" as tpldir
}

cloud "Optional extras" as extras {
  [scikit-learn, textstat, docsig\n(extra: standard)] as stdext
  [spaCy, textacy\n(extra: deep)] as deepext
}

precommit ..> cli : runs "docsentinel scan"
cli --> engine : scan / baseline\n(use_external_api)
cli --> engine : extract-facts ->\nextract_facts() (offline,\nno network edge)
api --> engine
plugin --> engine
cli --> reporting : render, render_facts
cli --> baseline : baseline cmd
cli --> deepsup : doctor
cli --> rules : rules cmd
cli --> telemetry : template/extension\nresolution

engine --> config
engine --> discovery : inventory +\ninvoker include / exclude\n(normalized, merged)
cli ..> discovery : early selector validation
engine --> rules
engine --> baseline : filter
engine --> models
engine --> standard : ensure_standard_loaded()
engine --> deepsup : deep gate
engine --> deep : DS302 gate (resolve_external_api_gate);\nextract_facts -> trace_candidates
cli ..> errors
engine --> unreadable : emits DS100 finding\n(ENGINE_RULES, all profiles)
engine --> corpus : reads each document once;\nonly readable ones go to analyzers
rules <.. unreadable : register Rule only
cli --> log : configure_cli_logging /\nshutdown_cli_logging
engine ..> log : safe()
discovery ..> log : safe()
fast ..> log : safe()
standard ..> log : safe()
deep ..> log : safe()
telemetry ..> log : safe()
log --> telemetry : filters.neutralize
log --> logfile : write (0600, rotated)
rules <.. fast : register Rule + Analyzer
rules <.. standard : register
rules <.. deep : register (eager)
fast --> mdblocks
telemetry --> mdblocks : path resolver
standard --> codedisc : DS204
standard --> miningcorpus : DS202, DS203
deep ..> claims : importlib, lazy
deep --> deepsup
deep ..> salience : importlib, lazy
salience ..> clustering : importlib, lazy
clustering --> miningcorpus : create_vectorizer
deep --> fcproto : FactCheckClient,\nload_backend (only gate-open)
fcproto ..> lenz : importlib, lazy,\nonly after both consent gates
lenz --> lenzsvc : HTTPS, opt-in: deep_confirm +\n~-~-use-external-api + API key;\nadvisory
lenz ..> fcproto : result types
miningcorpus --> models
claims --> models
deepsup --> models
miningcorpus ..> log : safe()
deepsup ..> log : safe()
standard ..> stdext : imports
deep ..> deepext : importlib, lazy
deepsup ..> deepext : readiness probe
claims ..> deepext
miningcorpus ..> stdext : scikit-learn
reporting --> telemetry
telemetry --> config
telemetry --> rules : classify
config --> cfgfiles : read (layer 3)
config --> usersettings : read (layer 2, C6-restricted,\nowner and mode gate)
config --> env : read (only config.py)
discovery --> corpus : inventory
baseline --> basefile : read/write
telemetry --> tpldir : read (containment-gated)

note bottom of engine
  Single entry point. Analyzers are called as
  detect(root, documents) or detect(root, documents, config).
  Deep: confirmation gate (deep_confirm, ~-~-i-understand-deep-is-heuristic,
  DOCSENTINEL_DEEP_CONFIRM=1) then deep_ready(); advisory-only, exit 0.
  Reads every discovered document once up front (_partition_readable);
  unreadable or non-UTF-8 ones get a DS100 error finding from the engine
  and are withheld from analyzers.
  Exit codes: 0 ok, 1 blocking findings, 2 config/scan failure.
end note

note as cfgnote
  Layers, lowest first: Config defaults < user settings JSON <
  project TOML or ~-~-config file (.json allowed) < CLI flags.
  Whole values are replaced, never merged. ~-~-no-user-settings turns
  layer 2 off. A Config passed to scan() is used verbatim.
  See sequence/config-layered-load.
end note
config .. cfgnote

note bottom of log
  Library stays quiet (NullHandler). Only the CLI configures handlers.
  Nearly every module (config, baseline, discovery, reporting, ...)
  also calls safe() for untrusted text; edges shown are representative.
end note

note bottom of lenz
  The first outbound network edge. Imported only after both
  consent gates are open (deep_confirm; ~-~-use-external-api or
  DOCSENTINEL_USE_EXTERNAL_API=1 AND the API key variable AND the
  backend loads). extract-facts never reaches it.
end note

note bottom of fast
  Fast profile: standard library only.
  importing docsentinel.detectors registers all fast rules
  and the DS301 rule (spaCy not imported).
end note
@enduml
