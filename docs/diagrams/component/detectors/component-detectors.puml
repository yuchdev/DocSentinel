@startuml component-detectors
title DocSentinel - detectors by profile (src/docsentinel/detectors)
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle

[rules.py\nregister_rule / ANALYZERS] as rules
[config.py] as config
[markdown_blocks.py\nscan_markdown, resolve_local_reference,\nMarkdownBlockIndex, AtReference] as mdb
[path_boundaries.py (DS116)\ncontained_path, is_ds116_owned,\nescapes_via_symlink, mention_ds116_reason;\nshared canonical_root() and _walk()] as pb

package "Fast DS1xx - stdlib only, imported eagerly by detectors package init" {
  package "Emitted by engine (all profiles), no analyzer" {
    [unreadable.py DS100\nemitted by engine (all profiles)\nin ENGINE_RULES, not in ANALYZERS] as ds100
  }
  package "Use the shared scanner" {
    [anchors.py DS104] as ds104
    [headings.py DS105] as ds105
    [sections.py DS106] as ds106
    [references.py DS108] as ds108
    [fences.py DS109] as ds109
    [fence_languages.py DS110\nopt-in: require_fence_languages] as ds110
    [navigation.py DS112\nopt-in: navigation_indexes] as ds112
    [assets.py DS113] as ds113
    [deprecated_refs.py DS115\nopt-in: deprecated_references_file] as ds115
    [tables.py DS117] as ds117
    [mentions.py DS124\nwarning, always active\nin link_root.LINK_ROOT_RULES] as ds124
  }
  package "Scanner-free" {
    [links.py DS101] as ds101
    [comments.py DS102] as ds102
    [paths.py DS103\nopt-in: reference_scope = "strict"] as ds103
    [document_ids.py DS114\nown frontmatter reader] as ds114
    [naming.py DS118\nopt-in: documentation_naming\npath strings only] as ds118
  }
}

package "Standard DS2xx - lazy: detectors/loader.py ensure_standard_loaded()" {
  [complexity.py DS201] as ds201
  [duplication.py DS202] as ds202
  [low_information.py DS203] as ds203
  [signatures.py DS204] as ds204
}

package "Deep DS301, DS302 - opt-in gate, advisory-only" {
  [contradictions.py DS301\nrule registered eagerly] as ds301
  [fact_check.py DS302\nresolve_external_api_gate, detect(),\ntrace_candidates / collect_candidates\n(the one candidate source)] as ds302
}

package "Mining layer - src/docsentinel/mining (depends only on models and log)" {
  [corpus.py\nbuild_corpus_model (lru_cache), paragraphs,\ncreate_vectorizer()] as corpus
  [claims.py\nClaim, extract_claims (lazy)] as triples
  [nlp.py\nload_pipeline, deep_ready()] as deepsup
  [salience.py\ntrace_salience, select_salient] as salience
  [clustering.py\ncluster_near_duplicates] as clustering
}

package "Backend package - src/docsentinel/fact_check (outside detectors/ and mining/)" {
  [protocol.py\nFactCheckClient Protocol, FactCheckResult,\nFactCheckError, load_backend] as fcproto
  [lenz.py\nLenzFactCheckClient (only httpx importer)] as lenz
}
[engine.py\nscan(), extract_facts()] as engine
[models.py] as models
[log.py] as log

[code_discovery.py] as codedisc
[detectors/loader.py] as loader
[errors.py\nExtraNotInstalledError] as errors

cloud "extra: standard" {
  [scikit-learn] as sk
  [textstat] as ts
  [docsig] as docsig
}
cloud "External Lenz service (POST /assess)" as lenzsvc

cloud "extra: deep" {
  [spaCy] as spacy
  [textacy] as textacy
}

ds100 ..> rules : register_rule only\n(no Analyzer)

ds104 --> mdb
ds105 --> mdb
ds106 --> mdb
ds108 --> mdb
ds109 --> mdb
ds110 --> mdb
ds112 --> mdb
ds113 --> mdb
ds115 --> mdb
ds117 --> mdb
ds124 --> mdb : AtReference /\nMarkdownBlockIndex.at_references
pb --> mdb

ds101 --> pb : contained_path,\nis_ds116_owned
ds103 --> pb : contained_path
ds112 --> pb
ds113 --> pb
ds115 --> pb
ds124 --> pb : contained_path,\nmention_ds116_reason

ds112 ..> config : ConfigError (fail-closed)
ds114 ..> config : ConfigError
ds115 ..> config : ConfigError
ds118 ..> config : ConfigError

ds202 --> corpus : mining.corpus
ds203 --> corpus : mining.corpus
corpus ..> sk
ds202 ..> sk
ds201 ..> ts
ds204 ..> docsig : importlib
ds204 --> codedisc

ds301 ..> deepsup : mining.nlp
ds301 ..> triples : mining.claims, importlib,\nfirst deep call
triples ..> spacy
triples ..> textacy : importlib
deepsup ..> spacy : readiness probe
deepsup ..> textacy

ds302 ..> triples : mining.claims, importlib
ds302 --> deepsup : mining.nlp
ds302 ..> salience : mining.salience, importlib
salience ..> clustering : importlib, lazy
clustering --> corpus : create_vectorizer
ds302 --> fcproto : FactCheckClient (Protocol boundary),\nload_backend, FactCheckError
fcproto ..> lenz : importlib, lazy,\nafter the consent gate
lenz --> fcproto : FactCheckResult
lenz --> lenzsvc : HTTPS, opt-in
ds302 ..> config : ConfigError, fact_check_* options
engine --> ds302 : resolve_external_api_gate;\nextract_facts -> trace_candidates

corpus --> models
triples --> models
deepsup ..> log
corpus ..> log
loader ..> errors : ExtraNotInstalledError\nwhen sklearn/textstat/docsig missing

ds101 ..> rules : each detector module\nregisters its Rule + Analyzer\nat import time
ds301 ..> rules
ds302 ..> rules : registered; in EXTERNAL_API_RULES

note right of ds100
  engine._partition_readable checks every document once;
  unreadable ones become DS100 errors from the engine and
  are never passed to any analyzer. Skips the evaluated
  count of ScanResult.notice.
end note

note right of pb
  DS116 owns unsafe targets (escape, drive, UNC,
  backslash, control). DS101/DS113/DS112/DS115
  defer to it via is_ds116_owned.
  Code-span scope is narrowed (Story 11.0).
end note

note bottom of ds302
  Consent gate: ~-~-use-external-api (or
  DOCSENTINEL_USE_EXTERNAL_API=1) AND the backend API key variable
  AND a loadable backend. Closed gate: one WARNING and a pending
  entry, nothing imported or sent. extract-facts calls the same
  trace_candidates offline: no gate, no backend, no network.
  No edge points from mining/ or fact_check/ up into detectors/,
  config or engine.
end note

note bottom of ds301
  Runs whenever profile = deep and deep_ready() holds,
  checked in engine.scan().
  Heuristic candidates only; exit code stays 0.
end note
@enduml
