{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.dmp)",
      "Read(./prototype/*.db)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python $CLAUDE_PROJECT_DIR/.github/hooks/scripts/session_start.py --host claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python $CLAUDE_PROJECT_DIR/.github/hooks/scripts/secret_scan.py --host claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python $CLAUDE_PROJECT_DIR/.github/hooks/scripts/post_edit_format.py --host claude"
          },
          {
            "type": "command",
            "command": "python $CLAUDE_PROJECT_DIR/.github/hooks/scripts/style_fixes.py --host claude"
          },
          {
            "type": "command",
            "command": "python $CLAUDE_PROJECT_DIR/.github/hooks/scripts/dep_audit.py --host claude"
          },
          {
            "type": "command",
            "command": "python $CLAUDE_PROJECT_DIR/.github/hooks/scripts/doc_link_check.py --host claude"
          }
        ]
      },
      {
        "matcher": "mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python $CLAUDE_PROJECT_DIR/.github/hooks/scripts/github_audit.py --host claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python $CLAUDE_PROJECT_DIR/.github/hooks/scripts/run_tests.py --host claude"
          },
          {
            "type": "command",
            "command": "python $CLAUDE_PROJECT_DIR/.github/hooks/scripts/doc_link_check.py --host claude"
          }
        ]
      }
    ]
  }
}
